# Copy to .env for local development. Never commit .env.
# Local values match docker-compose.yml; these credentials are for local use only.

POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=acme_pay
POSTGRES_PORT=5432

# Used by the API (SQLAlchemy async URL).
DATABASE_URL=postgresql+asyncpg://acme:acme@localhost:5432/acme_pay

# Optional: enables the AI pay analyst (free key from https://aistudio.google.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
